    """Run temperature calibration."""
    script = os.path.join(REPO_ROOT, "training", "calibrate.py")
    py = VENV_PYTHON if os.path.exists(VENV_PYTHON) else sys.executable
    subprocess.run([py, script])


def cmd_move_window(args: list[str]):
    """Move active window or named application to target workspace."""
    if not args:
        print("Usage: omarchy-eva move-window [app_name] <workspace|another|next|prev>")
        print("Examples:")
        print("  omarchy-eva move-window 2")
        print("  omarchy-eva move-window another")
        print("  omarchy-eva move-window next")
        print("  omarchy-eva move-window spotify 4")
        print("  omarchy-eva move-window discord another")
        return

    if len(args) == 1:
        target = args[0]
        cmd_text = f"move window to workspace {target}" if target.isdigit() else f"move window to {target} workspace"
    else:
        app_name = " ".join(args[:-1])
        target = args[-1]
        cmd_text = f"move {app_name} to workspace {target}" if target.isdigit() else f"move {app_name} to {target} workspace"

    resp = send_ipc("execute_text", {"text": cmd_text}, timeout=3.0)
    if resp and resp.get("status") == "ok":
        r = resp.get("result", {})
        if r.get("speech"):
            print(f"🪟 {r.get('speech')} ({r.get('latency_ms', 0)}ms)")
        else:
            print(f"🪟 Action: {r.get('action')} (Success={r.get('success')})")
        return

    disp = CommandDispatcher()
    res = disp.dispatch_text(cmd_text, execute=True)
    if res.get("speech"):
        print(f"🪟 {res.get('speech')} ({res.get('latency_ms', 0)}ms)")
    else:
        print(f"🪟 Action: {res.get('action')} (Success={res.get('success')})")


