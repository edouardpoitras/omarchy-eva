    print("═" * 78)
    print(f"Name:             {ident['name']}")
    print(f"Role:             {ident['role']}")
    print(f"Environment:      {ident['system']}")
    print(f"System 1 Engine:  {ident['tier1']}")
    print(f"System 2 Engine:  {ident['tier2']}")
    print(f"Voice / Audio:    {ident['voice']}")
    print(f"Visual Interface: {ident['ui']}")
    print(f"Registered Rules: {ident['total_intents']} Intent Categories across {ident['total_templates']} grammar templates")
    print("═" * 78)
    print("Butler Persona Speech:")
    print(f"\"{ident['speech']}\"")
    print("═" * 78)


def cmd_capabilities(args: list[str]):
    """Show capability matrix or drill down into a specific domain."""
    from core.capabilities import capabilities_registry
    if args:
        target_domain = " ".join(args).strip()
        print(capabilities_registry.format_cli_domain(target_domain))
    else:
        print(capabilities_registry.format_cli_overview())


def cmd_steam(args: list[str]):
    """Manage and launch Steam games."""
    from core.steam_indexer import SteamIndexer
    steam = SteamIndexer()
    sub = args[0] if args else "list"

    if sub == "list":
        games = steam.list_games()
        if not games:
            print("No Steam games detected.")
            return
        print(f"🎮 Installed Steam Games ({len(games)}):")
        print(f"   {'APP ID':<10} {'TITLE':<38} {'INSTALL DIR'}")
        print("   " + "-" * 68)
        for g in games:
            print(f"   {g['appid']:<10} {g['name']:<38} {g.get('installdir', '')}")
    elif sub in ("launch", "play", "run"):
        if len(args) < 2:
            print("Usage: omarchy-eva steam launch <game name or appid>")
            sys.exit(1)
        query = " ".join(args[1:])
        res = steam.launch_game(query)
        if res.get("success"):
            print(f"🚀 Launched {res.get('name')} (App ID: {res.get('appid')}) via Steam.")
        else:
            print(f"Error: {res.get('error')}")
            sys.exit(1)
    else:
        query = " ".join(args)
        res = steam.launch_game(query)
        if res.get("success"):
            print(f"🚀 Launched {res.get('name')} (App ID: {res.get('appid')}) via Steam.")
        else:
            print(f"Error: {res.get('error')}")
            sys.exit(1)


def cmd_repeat():
    """Repeat the last statement or output spoken by Eva."""
    if is_daemon_alive():
        resp = send_ipc("repeat")
        if resp and resp.get("status") == "ok":
            stmt = resp.get("statement") or resp.get("speech") or "I haven't said anything yet."
            print(f"🗣️  Repeated: \"{stmt}\"")
            return
        resp = send_ipc("execute_text", {"text": "repeat that"})
        if resp and resp.get("status") == "ok":
            res = resp.get("result", {})
            stmt = res.get("speech") or res.get("response") or "I haven't said anything yet."
            print(f"🗣️  Repeated: \"{stmt}\"")
            return

    from core.dispatcher import CommandDispatcher
    d = CommandDispatcher()
    res = d.dispatch_text("repeat that")
    stmt = res.get("speech") or res.get("response") or "I haven't said anything yet."
    print(f"🗣️  Repeated: \"{stmt}\"")


def cmd_wake_word(args: list):
    """Inspect or control wake word passive listening."""
    from core.config import eva_config
    if not args or args[0] in ("status", "info"):
        resp = send_ipc("wake_word_status")
        if not resp:
            print("Eva daemon is not active. Start daemon to use wake word.")
            return
        enabled = resp.get("wake_word_enabled", False)
        avail = resp.get("available", False)
        running = resp.get("running", False)
        state = resp.get("state", "unknown")
        call_active = resp.get("is_call_active", False)
        print(f"Wake Word ('Eva' / 'Hey Eva'): {'Enabled' if enabled else 'Disabled'}")
        print(f"KWS Model Available        : {'Yes' if avail else 'No (missing ~/.local/share/eva/models/kws)'}")
        print(f"Passive Audio Stream       : {'Active' if running else 'Inactive'}")
        print(f"Listener State             : {state}")
        if call_active:
            print("⚠️  VoIP Call In Progress  : Wake word paused for call privacy")
    elif args[0] in ("on", "enable", "start"):
        resp = send_ipc("set_config", {"key": "wake_word_enabled", "value": True})
        send_ipc("wake_word_toggle") if not send_ipc("wake_word_status", {}).get("running") else None
        eva_config.set("wake_word_enabled", True)
        print("✅ Passive wake word listening enabled ('Eva' / 'Hey Eva').")
    elif args[0] in ("off", "disable", "stop"):
        send_ipc("set_config", {"key": "wake_word_enabled", "value": False})
        eva_config.set("wake_word_enabled", False)
        print("⏸️  Passive wake word listening disabled.")
    elif args[0] in ("toggle",):
        resp = send_ipc("wake_word_toggle")
        if resp and "wake_word_enabled" in resp:
            val = resp["wake_word_enabled"]
            print(f"Wake word listening is now {'Enabled' if val else 'Disabled'}.")
        else:
            curr = bool(eva_config.get("wake_word_enabled", True))
            eva_config.set("wake_word_enabled", not curr)
            print(f"Wake word listening set to {not curr}.")
    else:
        print("Usage: omarchy-eva wake-word [status|on|off|toggle]")


def cmd_follow_up(args: list):
    """Inspect or control conversational follow-up mode."""
    from core.config import eva_config
    if not args or args[0] in ("status", "info"):
        resp = send_ipc("wake_word_status")
        if resp:
            fm = resp.get("follow_up_mode", False)
            active = resp.get("follow_up_active", False)
            print(f"Follow-Up Mode   : {'Enabled' if fm else 'Disabled'}")
            print(f"Currently Active : {'Yes (listening for follow-up speech)' if active else 'No'}")
        else:
            fm = bool(eva_config.get("follow_up_mode", True))
            print(f"Follow-Up Mode: {'Enabled' if fm else 'Disabled'} (daemon offline)")
    elif args[0] in ("on", "enable"):
        send_ipc("set_config", {"key": "follow_up_mode", "value": True})
        eva_config.set("follow_up_mode", True)
        print("✅ Follow-up mode enabled (8-second open mic window after commands).")
    elif args[0] in ("off", "disable"):
        send_ipc("set_config", {"key": "follow_up_mode", "value": False})
        eva_config.set("follow_up_mode", False)
        print("⏸️  Follow-up mode disabled.")
    elif args[0] in ("toggle",):
        resp = send_ipc("follow_up_toggle")
        if resp and "follow_up_mode" in resp:
            val = resp["follow_up_mode"]
            print(f"Follow-up mode is now {'Enabled' if val else 'Disabled'}.")
        else:
            curr = bool(eva_config.get("follow_up_mode", True))
            eva_config.set("follow_up_mode", not curr)
            print(f"Follow-up mode set to {not curr}.")
    else:
        print("Usage: omarchy-eva follow-up [status|on|off|toggle]")


def print_help():
    print("""Omarchy Eva Voice Automation CLI

Usage:
  omarchy-eva trigger               Toggle voice recording (SUPER+SHIFT+CTRL+X)
  omarchy-eva record-start          Start voice capture (push-to-talk press)
  omarchy-eva record-stop           Stop voice capture & execute (push-to-talk release)
  omarchy-eva exec <command...>     Directly execute command text
  omarchy-eva repeat                Repeat the last statement or output spoken by Eva
  omarchy-eva wake-word [on|off]    Control hands-free passive wake word detection ("Eva")
  omarchy-eva follow-up [on|off]    Control 8-second conversational follow-up window
  omarchy-eva ask <prompt...>       Deliberative System 2 reasoning with spoken reply
  omarchy-eva see [prompt...]       Inspect screen with vision agent and speak response
  omarchy-eva speak <text...>       Synthesize & speak via Kokoro-82M neural TTS
  omarchy-eva voices                List available Kokoro voices
  omarchy-eva sound [name]          Play acoustic earcon (listening, success, deliberate, error)
  omarchy-eva hud                   Demonstrate floating Arc-Reactor HUD overlay
  omarchy-eva route <command...>    Evaluate hierarchical System 1 routing & token extraction
  omarchy-eva models                List available decision models and active local engine
  omarchy-eva set-engine <name>     Switch active decision model (clef-flash, clef, laya)
  omarchy-eva classify <text...>    Evaluate Laya decision model & calibrated confidence
  omarchy-eva status                Show daemon status

System Overview & Capabilities:
  omarchy-eva config [get|set|show]    View or adjust Eva configuration settings
  omarchy-eva info                  Show Eva identity, architecture, and persona
  omarchy-eva capabilities [domain] Display capabilities matrix or drill down into a domain

Reflex Desktop Controls & Telemetry:
  omarchy-eva steam [list|launch <game>] Discover and launch Steam games
  omarchy-eva apps                  List indexed desktop applications
  omarchy-eva move-window [app] <ws> Move active window or app to target workspace
  omarchy-eva close [app_name]      Close specified application or active window
  omarchy-eva top [--by cpu|memory] Show top resource-consuming processes
  omarchy-eva audio [output|input|list] [dev] Switch audio output or mic
  omarchy-eva wifi [list|connect|disconnect] Manage Wi-Fi connections
  omarchy-eva bluetooth [list|connect|disc] Manage Bluetooth devices
  omarchy-eva brightness [level|up|down] Adjust screen brightness
  omarchy-eva display [list|scale]  Query displays or adjust scaling
  omarchy-eva system <action>       Hardware telemetry & power (battery, disk, ram, ip, shutdown...)
  omarchy-eva clipboard [read|clear] Read or clear Wayland clipboard
  omarchy-eva awareness             Show background sentinel status (CPU, RAM, network, weather)
  omarchy-eva alert [message...]    Trigger a proactive test alert

Screen Perception & Virtual Input:
  omarchy-eva screenshot [--window] Take sub-35ms screenshot (.cache/eva/screen.jpg)
  omarchy-eva move <x> <y>          Move cursor with subtle ease-out delay
  omarchy-eva click <target|x y>    Click visual UI element or (x, y) coordinates
  omarchy-eva type <text...>        Type text with natural human keystroke cadence

Machine Learning & Model Tuning:
  omarchy-eva generate              Generate training dataset from schema
  omarchy-eva train                 Fine-tune Laya ModernBERT on GPU/CPU & export to ONNX
  omarchy-eva calibrate             Run Platt temperature scaling & calibration check
  omarchy-eva --help                Show this message
""")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd in ("trigger", "record-toggle"):
        cmd_trigger()
    elif cmd == "record-start":
        cmd_record_start()
    elif cmd == "record-stop":
        cmd_record_stop()
    elif cmd in ("exec", "run"):
        cmd_exec(sys.argv[2:])
    elif cmd in ("repeat", "again", "say-again"):
        cmd_repeat()
    elif cmd in ("wake-word", "wakeword", "wake"):
        cmd_wake_word(sys.argv[2:])
    elif cmd in ("follow-up", "followup"):
        cmd_follow_up(sys.argv[2:])
    elif cmd in ("ask", "agent", "query"):
        cmd_ask(sys.argv[2:])
    elif cmd in ("see", "vision", "look"):
        cmd_see(sys.argv[2:])
    elif cmd in ("screenshot", "capture", "shot"):
        cmd_screenshot(sys.argv[2:])
    elif cmd in ("move", "mousemove"):
        cmd_move(sys.argv[2:])
    elif cmd in ("click", "mouseclick"):
        cmd_click(sys.argv[2:])
    elif cmd == "top":
        cmd_top(sys.argv[2:])
    elif cmd in ("apps", "list-apps"):
        cmd_apps()
    elif cmd in ("steam", "games", "game"):
        cmd_steam(sys.argv[2:])
    elif cmd in ("move-window", "window-move", "moveto"):
        cmd_move_window(sys.argv[2:])
    elif cmd in ("close", "kill-app", "quit-app"):
        cmd_close(sys.argv[2:])
    elif cmd in ("audio", "sound-device"):
        cmd_audio(sys.argv[2:])
    elif cmd in ("wifi", "network-wifi"):
        cmd_wifi(sys.argv[2:])
    elif cmd in ("bluetooth", "bt"):
        cmd_bluetooth(sys.argv[2:])
    elif cmd in ("brightness", "bright", "backlight"):
        cmd_brightness(sys.argv[2:])
    elif cmd in ("display", "displays", "monitor", "monitors"):
        cmd_display(sys.argv[2:])
    elif cmd in ("system", "sys", "power"):
        cmd_system(sys.argv[2:])
    elif cmd in ("clipboard", "clip"):
        cmd_clipboard(sys.argv[2:])
    elif cmd in ("awareness", "sentinel", "watchdog"):
        cmd_awareness()
    elif cmd in ("alert", "warn", "notify"):
        cmd_alert(sys.argv[2:])
    elif cmd in ("type", "keystroke"):
        cmd_type(sys.argv[2:])
    elif cmd in ("sound", "earcon", "play"):
        cmd_sound(sys.argv[2:])
    elif cmd in ("hud", "overlay"):
        cmd_hud(sys.argv[2:])
    elif cmd == "speak":
        cmd_speak(sys.argv[2:])
    elif cmd == "voices":
        cmd_voices()
    elif cmd == "classify":
        cmd_classify(sys.argv[2:])
    elif cmd in ("route", "router"):
        cmd_route(sys.argv[2:])
    elif cmd in ("models", "engines"):
        cmd_models(sys.argv[2:])
    elif cmd in ("set-engine", "set-model"):
        cmd_set_engine(sys.argv[2:])
    elif cmd in ("info", "identity", "whoami"):
        cmd_info()
    elif cmd in ("capabilities", "caps", "features"):
        cmd_capabilities(sys.argv[2:])
    elif cmd == "generate":
        cmd_generate(sys.argv[2:])
    elif cmd == "train":
        cmd_train(sys.argv[2:])
    elif cmd == "calibrate":
        cmd_calibrate()
    elif cmd == "status":
        cmd_status()
    elif cmd in ("config", "cfg", "settings"):
        cmd_config(sys.argv[2:])
    else:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
